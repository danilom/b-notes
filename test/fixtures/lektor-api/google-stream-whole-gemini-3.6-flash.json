      "text": "event: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\"Najviše mi je ostala slika susreta kod česme i tvoja\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" zabeleška „o stanicama na kojima više niko ne čeka”. Ostala mi je zato što iz te\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" jedne misli izbija snažan osećaj prolaznosti i tišine koja ostaje za\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" nekim prošlim vremenima, pa je taj razgovor naglo promenio ton celog tvog jutra\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\".\\n\\nZastao sam na mestu gde kažeš „iako znam da je niko u kući neće\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\n"
    },
    {
      "atMs": 51555,
      "text": "event: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" jesti osim mene”. Tu sam poželeo da kažeš nešto više o tvojoj kući i odnosima u njoj, jer\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" je ta sitnica ostavila utisak neke tihe usamljenosti o kojoj si samo usput namignuo.\\n\\nCelo\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" ovo tvoje pisanje deluje kao miran, kratak zapis iz zore u kom se kroz jednostavne\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" radnje prepliću miris novog dana i nostalgija starog čoveka. Priča drži\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\nevent: step.delta\ndata: {\"index\":1,\"delta\":{\"text\":\" ujednačen, tih ritam u kom se svakodnevna kupovina lako pretvara u prostor za razmiš\",\"type\":\"text\"},\"event_type\":\"step.delta\"}\n\n"
